	column 'Age Group' = ```
			
			SWITCH(
			    TRUE(),
			    'hr_attrition_clean'[Age] < 25, "Under 25",
			    'hr_attrition_clean'[Age] < 35, "25-34",
			    'hr_attrition_clean'[Age] < 45, "35-44",
			    'hr_attrition_clean'[Age] < 55, "45-54",
			    "55+"
			)
			
			```
		lineageTag: 6b8704dc-9027-4d95-83e1-072cd85980af
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column monthly_income_groups =
			
			SWITCH(
			    TRUE(),
			    hr_attrition_clean[MonthlyIncome]<5000, "Monthly income less 5000",
			    hr_attrition_clean[MonthlyIncome]<10000, "Monthly income between 5000 and 10000",
			    hr_attrition_clean[MonthlyIncome]<15000, "Monthly income between 10000 and 15000",
			    "Monthly Income more than 15000"
			)
		lineageTag: 97846c86-badf-45eb-a71d-f2201296cd86
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

