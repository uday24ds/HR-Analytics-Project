table hr_attrition_clean
	lineageTag: 8899fdb6-1ddf-42d1-8fab-5c2f634d22eb

	measure 'Total Employees' = COUNTROWS(hr_attrition_clean)
		formatString: 0.00
		lineageTag: 68fbb425-d797-44e7-9f7f-c4c59ee6ae5c

	measure Employees_left = CALCULATE(COUNT(hr_attrition_clean[EmployeeNumber]), hr_attrition_clean[Attrition]=1)
		formatString: 0
		lineageTag: 4a66dfb5-716e-4e94-8b8c-f442aea77f88

	measure Attrition_rate = DIVIDE([Employees_left], COUNT(hr_attrition_clean[EmployeeNumber]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: aa523f7c-907e-484d-9c63-7a3eb3f0969b

	measure 'Average Monthly Income' =
			
			AVERAGE(hr_attrition_clean[MonthlyIncome])
		lineageTag: e05a6cbc-4c74-458a-a3fe-7a4892daa74c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Tenure' =
			
			AVERAGE(hr_attrition_clean[YearsAtCompany])
		lineageTag: fece9302-a879-4d05-8fc3-1c57a07d059e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Main Dashboard' = "HR ANALYTICS | EMPLOYEE ATTRITION"
		lineageTag: 409ae0af-0674-4388-9164-6a945a611fef

	measure Monthly_income = ```
			
			VAR max_income= MAX(hr_attrition_clean[MonthlyIncome]) 
			VAR min_income =MIN(hr_attrition_clean[MonthlyIncome])
			
			RETURN min_income
			```
		formatString: 0
		lineageTag: fb77480b-0d78-427b-af30-b504cf7aad77

